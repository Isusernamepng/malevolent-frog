def distance(a, b):
    return math.hypot(a[0]-b[0], a[1]-b[1])


def point_on_path(x, y):
    for a, b in zip(PATH, PATH[1:]):
        dx = b[0]-a[0]
        dy = b[1]-a[1]
        length_sq = dx*dx+dy*dy

        if length_sq == 0:
            continue

        q = max(0, min(
            1, ((x-a[0])*dx+(y-a[1])*dy)/length_sq
        ))

        px = a[0]+q*dx
        py = a[1]+q*dy

        if math.hypot(x-px, y-py) < 43:
            return True

    return False


