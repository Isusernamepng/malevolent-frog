def draw_frog(t, x, y, scale=1.0, color="#62c85d",
              outline="#173d32"):
    # Body
    t.penup()
    t.goto(x-22*scale, y-7*scale)
    t.color(outline, color)
    t.pendown()
    t.begin_fill()

    for px, py in [
        (x-24*scale, y-7*scale),
        (x-22*scale, y-20*scale),
        (x-12*scale, y-25*scale),
        (x+12*scale, y-25*scale),
        (x+22*scale, y-20*scale),
        (x+24*scale, y-7*scale),
        (x, y)
    ]:
        t.goto(px, py)

    t.end_fill()
    t.penup()

    circle(t, x, y-9*scale, 17*scale, color, outline)

    # Raised eyes
    circle(t, x-12*scale, y+5*scale, 8*scale, color, outline)
    circle(t, x+12*scale, y+5*scale, 8*scale, color, outline)
    circle(t, x-12*scale, y+5*scale, 4.3*scale, "#fff8dc")
    circle(t, x+12*scale, y+5*scale, 4.3*scale, "#fff8dc")
    circle(t, x-11*scale, y+4*scale, 2.1*scale, "#18202b")
    circle(t, x+13*scale, y+4*scale, 2.1*scale, "#18202b")

    # Nostrils and smile
    circle(t, x-7*scale, y-9*scale, 1.8*scale, outline)
    circle(t, x+7*scale, y-9*scale, 1.8*scale, outline)
    line(t, [
        (x-10*scale, y-15*scale),
        (x-5*scale, y-18*scale),
        (x+5*scale, y-18*scale),
        (x+10*scale, y-15*scale)
    ], outline, max(1, int(2*scale)))

    # Feet and toes
    for dx in (-16, -8, 8, 16):
        circle(t, x+dx*scale, y-25*scale,
               2.6*scale, color, outline)


def draw_tomatrog(t, x, y, scale=1.0):
    draw_frog(t, x, y, scale, "#df5148", "#692a2b")
    circle(t, x, y+15*scale, 5*scale, "#4b9d47")

    for a in range(5):
        angle = math.radians(a*72)
        xx = x+math.cos(angle)*7*scale
        yy = y+15*scale+math.sin(angle)*5*scale
        circle(t, xx, yy, 2*scale, "#4b9d47")


def draw_tofuwog(t, x, y, scale=1.0):
    rect(t, x-19*scale, y-21*scale,
         38*scale, 26*scale, "#f5e8c8", "#6b5c45")
    draw_frog(t, x, y+5*scale, scale*.75,
              "#e9d7aa", "#776449")


def magic_poly(t, x, y, points, scale, color, outline=None):
    """Draw a polygon whose points are relative to its center."""
    t.penup()
    t.goto(x + points[0][0]*scale, y + points[0][1]*scale)
    t.color(outline or color, color)
    t.pendown()
    t.begin_fill()
    for px, py in points[1:]:
        t.goto(x + px*scale, y + py*scale)
    t.goto(x + points[0][0]*scale, y + points[0][1]*scale)
    t.end_fill()
    t.penup()


def magic_ellipse(t, x, y, rx, ry, color, outline=None, scale=1.0):
    pts = [(rx*math.cos(i*math.pi/36), ry*math.sin(i*math.pi/36))
           for i in range(73)]
    magic_poly(t, x, y, pts, scale, color, outline)


