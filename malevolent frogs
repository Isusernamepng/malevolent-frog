        text(art, -355, y+1,
             f'{name} - {info["rarity"]} - Owned: {owned(name)}',
             10, RARITY_COLORS[info["rarity"]])

        is_equipped = name in save["equipped"]

        button(
            "UNEQUIP" if is_equipped else "EQUIP",
            280, y-18, 115, 30,
            lambda n=name: toggle_equip(n),
            "#8d393e" if is_equipped else "#286b53"
        )

        y -= 54

    button("HOME", -90, -320, 180, 40,
           draw_home, "#334766")
    screen.update()


# ============================================================
# MATCH DISPLAY
# ============================================================

def toggle_pause():
    if game and not game["won"] and not game["lost"]:
        game["paused"] = not game["paused"]


def render_match():
    global BUTTONS

    if not game:
        return

    art.clear()
    BUTTONS = []

    # Draw towers. A tower's range is shown only when selected.
    for i, tower in enumerate(game["towers"]):
        info = FROGS[tower["name"]]

        if game["selected_tower"] == i:
            radius = info["range"]+(tower["level"]-1)*8
            art.penup()
            art.goto(tower["x"], tower["y"]-radius)
            art.pencolor("#7be4a0")
            art.pensize(2)
            art.pendown()
            art.circle(radius)
            art.penup()
            art.pensize(1)

        draw_unit(art, tower["name"],
                  tower["x"], tower["y"]+7, .65)

        if tower["name"] == "Magic Frog":
            text(art, tower["x"], tower["y"]-38, "SUMMONER", 7, "#00ff00", "center")

        if tower["level"] > 1:
            text(art, tower["x"], tower["y"]-28,
                 f'Lv.{tower["level"]}', 8,
                 "#ffdf62", "center")

    for minion in game.get("minions", []):
        draw_magic_minion(minion)

    for enemy in game["enemies"]:
        draw_enemy(enemy)

    # Top HUD
    rect(art, -550, 350, 1100, 30, "#101827")
    text(art, -520, 359, f'Coins: {game["coins"]}',
         11, "#ffdf62")
    text(art, -390, 359, f'Lives: {game["lives"]}',
         11, "#ff7b7b")
    text(art, -270, 359,
         f'Wave: {game["wave"]}/{game["map"]["waves"]}',
         11, "white")
    text(art, -60, 359,
         f'Coins earned: +{game["coins_gained"]}',
         11, "#8df2a0")
    button("PAUSE" if not game["paused"] else "RESUME",
           325, 351, 85, 27, toggle_pause, "#334766")
    button("HOME", 425, 351, 85, 27,
           draw_home, "#8d393e")

    # Bottom tower bar
    rect(art, -550, -380, 1100, 55, "#101827")
    text(art, -530, -347, "PLACE FROGS",
         9, "#b6c9d9")

    for i, name in enumerate(save["equipped"][:8]):
        x = -400+i*112
        info = FROGS[name]
        selected = game["placing"] == name

        rect(art, x, -373, 104, 43,
             "#496d5b" if selected else "#24364a",
             info["color"])

        draw_unit(art, name, x+14, -350, .32)
        text(art, x+27, -348, name[:11], 8, "white")
        text(art, x+27, -364,
             f'Cost {info["cost"]}', 8, "#ffdf62")

        BUTTONS.append((
            x, -373, x+104, -330,
            lambda n=name: select_placing(n)
        ))

    # Selected tower upgrade
    idx = game["selected_tower"]

    if idx is not None and idx < len(game["towers"]):
        tower = game["towers"][idx]
        cost = 60*tower["level"]

        text(art, 180, -295,
             f'{tower["name"]} Lv.{tower["level"]}',
             10, FROGS[tower["name"]]["color"])

        button(f"UPGRADE ({cost})",
               345, -330, 150, 30,
               upgrade_selected, "#5b438c")
        sell_refund = int(FROGS[tower["name"]]["cost"] * 0.75)
        button(f"SELL (+{sell_refund})",
               345, -365, 150, 28,
               sell_selected, "#a84a43")

    if game["placing"]:
        text(art, 0, -295,
             f'Click an open area to place {game["placing"]}.',
             10, "#a5ffb5", "center")

    if time.monotonic() < game["notice_until"]:
        text(art, 0, 324, game["notice"],
             10, "#fff2a6", "center")

    if game["paused"] and not game["won"] and not game["lost"]:
        rect(art, -180, -40, 360, 100,
             "#182536", "#c9d5e3")
        text(art, 0, 12, "PAUSED",
             25, "#ffdf62", "center")
        text(art, 0, -18, "Press SPACE or RESUME",
             11, "white", "center")

    if game["won"] or game["lost"]:
        rect(art, -250, -110, 500, 300,
             "#172437", "#a9c4d8")

        if game["won"]:
            text(art, 0, 160, "VICTORY!",
                 29, "#8df2a0", "center")
            text(art, 0, 130,
                 f'You earned {game["map"]["reward"]} saved coins!',
                 12, "#ffdf62", "center")
            if game.get("cat_reward_message"):
                text(art, 0, 105, game["cat_reward_message"], 10, "#ff9be2", "center")
        else:
            text(art, 0, 160, "DEFEAT",
                 29, "#ff7b7b", "center")
            text(art, 0, 130,
                 "The enemies reached the exit.",
                 12, "white", "center")

        text(art, 0, 93,
             f'Match coins earned: {game["coins_gained"]}',
             12, "#8df2a0", "center")
        text(art, 0, 68,
             f'Waves reached: {game["wave"]}',
             11, "white", "center")

        button("GO TO HOME", -170, 5, 155, 42,
               draw_home, "#286b53")
        button("MAP SELECT", 15, 5, 155, 42,
               draw_maps, "#365b85")

    screen.update()


# ============================================================
# CLICK AND KEYBOARD CONTROLS
# ============================================================

def click(x, y):
    if page == "match" and game:
        # Buttons are checked first, including end-screen buttons.
        for x1, y1, x2, y2, callback in reversed(BUTTONS):
            if x1 <= x <= x2 and y1 <= y <= y2:
                callback()

                if page == "match":
                    render_match()
                return

        if game["won"] or game["lost"]:
            return

        if game["placing"]:
            place_tower(x, y)
            render_match()
            return

        clicked = None

        for i, tower in enumerate(game["towers"]):
            if distance((x, y), (tower["x"], tower["y"])) < 27:
                clicked = i
                break

        # Click the selected tower again to hide its range.
        if clicked is not None:
            if game["selected_tower"] == clicked:
                game["selected_tower"] = None
            else:
                game["selected_tower"] = clicked
        else:
            game["selected_tower"] = None

        render_match()
        return

    for x1, y1, x2, y2, callback in reversed(BUTTONS):
        if x1 <= x <= x2 and y1 <= y <= y2:
            callback()
            return


def key_space():
    if page == "match" and game:
        toggle_pause()
        render_match()


def select_equipped_by_key(index):
    if page == "match" and game and index < len(save["equipped"]):
        select_placing(save["equipped"][index])
        render_match()


screen.onclick(click)
screen.onkey(key_space, "space")

for i in range(8):
    screen.onkey(
        lambda idx=i: select_equipped_by_key(idx),
        str(i+1)
    )

screen.listen()


# ============================================================
# ONE ANIMATION LOOP
# ============================================================

last_tick = time.monotonic()


def app_tick():
    global last_tick

    now = time.monotonic()
    dt = min(.04, max(0, now-last_tick))
    last_tick = now

    if page == "match" and game:
        if not game["won"] and not game["lost"]:
            update_game(dt)

        render_match()

    # Schedule exactly one next update.
    screen.ontimer(app_tick, FRAME_MS)


# Start on the home menu.
draw_home()
screen.ontimer(app_tick, FRAME_MS)
screen.mainloop()
