def start_summon():
    global summon_message

    if save["coins"] < SUMMON_COST:
        summon_message = "Not enough saved coins!"
        draw_summon()
        return

    save["coins"] -= SUMMON_COST

    # Secret chance is exactly 0.001% (1 in 100,000) per summon.
    if random.random() < 0.00001:
        name = "Magic Frog"
        save["inventory"][name] = owned(name)+1
        summon_message = "SECRET FOUND! You summoned Magic Frog!"
        save_game()
        draw_summon()
        return

    roll = random.random()*100
    total = 0
    rarity = "Mythical"

    for r, odds in RARITY_ODDS:
        total += odds

        if roll < total:
            rarity = r
            break

    choices = [
        name for name, info in FROGS.items()
        if info["rarity"] == rarity and not info.get("event", False)
        and not info.get("cat_reward", False)
    ]

    name = random.choice(choices)
    save["inventory"][name] = owned(name)+1

    summon_message = f"{rarity}! You summoned {name}!"
    save_game()
    draw_summon()


