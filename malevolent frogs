def start_wave(number):
    """Starts exactly the requested wave."""
    if not game or number > game["map"]["waves"]:
        return

    game["wave"] = number

    # Big Update 2: noticeably larger enemy waves on every map.
    count = 8 + number*3

    if game["map"]["difficulty"] == "Medium":
        count += 3
    elif game["map"]["difficulty"] == "Hard":
        count += 6
    elif game["map"]["difficulty"] == "Expert":
        count += 10 + number

    game["spawn_left"] = count
    game["wave_spawn_total"] = count
    game["spawn_timer"] = .25
    game["prep"] = 0
    game["wave_complete"] = False
    game["notice"] = f'WAVE {number} / {game["map"]["waves"]}!'
    game["notice_until"] = time.monotonic()+2.5


def spawn_enemy():
    cfg = game["map"]
    wave = game["wave"]

    # The first enemy of the last two waves is always Grapefin.
    first_spawn = game["spawn_left"] == game["wave_spawn_total"]
    boss_wave = wave >= cfg["waves"]-1

    if boss_wave and first_spawn:
        kind = "Grapefin"
    elif wave >= 4 and random.random() < .25:
        kind = "Walamander"
    elif wave >= 2 and random.random() < .22:
        kind = "Squarelamander"
    else:
        kind = random.choice(["Fih", "Flyet"])

    info = ENEMIES[kind]
    hp_scale = cfg["hp"]*(1+(wave-1)*.12)
    if cfg["difficulty"] == "Expert":
        hp_scale *= 1.15
    hp = info["hp"]*hp_scale

    game["enemies"].append({
        "kind": kind,
        "x": PATH[0][0],
        "y": PATH[0][1],
        "segment": 0,
        "hp": hp,
        "maxhp": hp,
        "speed": info["speed"]*cfg["speed"]*(1+(wave-1)*.02),
        "reward": info["reward"],
    })


def move_enemy(enemy, dt):
    remaining = enemy["speed"]*dt

    while remaining > 0 and enemy["segment"] < len(PATH)-1:
        target = PATH[enemy["segment"]+1]
        dx = target[0]-enemy["x"]
        dy = target[1]-enemy["y"]
        dist = math.hypot(dx, dy)

        if dist < .001:
            enemy["segment"] += 1
            continue

        if remaining >= dist:
            enemy["x"], enemy["y"] = target
            enemy["segment"] += 1
            remaining -= dist
        else:
            enemy["x"] += dx/dist*remaining
            enemy["y"] += dy/dist*remaining
            remaining = 0

    if enemy["segment"] >= len(PATH)-1:
        game["lives"] -= 1
        return False

    return True


def record_enemy_kill(kind):
    """Persist first-discovery and total kill count for the enemy index."""
    kills = save.setdefault("enemy_kills", {})
    kills[kind] = int(kills.get(kind, 0)) + 1
    save_game()


def move_minion(minion, dt):
    """Move a summoned ally along the path and let it skirmish with enemies."""
    # Minions advance along the track, stopping near enemies to attack them.
    minion["attack_cooldown"] = max(0, minion["attack_cooldown"] - dt)
    nearby = [e for e in game["enemies"]
              if distance((minion["x"], minion["y"]), (e["x"], e["y"])) < 24]
    if nearby:
        target = nearby[0]
        if minion["attack_cooldown"] <= 0:
            target["hp"] -= minion["damage"]
            minion["attack_cooldown"] = 1.0
            if target["hp"] <= 0 and target in game["enemies"]:
                game["enemies"].remove(target)
                game["coins"] += target["reward"]
                game["coins_gained"] += target["reward"]
                game["kills"] += 1
                record_enemy_kill(target["kind"])
        return True

    remaining = minion["speed"] * dt
    while remaining > 0 and minion["segment"] < len(PATH)-1:
        target = PATH[minion["segment"]+1]
        dx, dy = target[0]-minion["x"], target[1]-minion["y"]
        dist = math.hypot(dx, dy)
        if dist < .001:
            minion["segment"] += 1
            continue
        if remaining >= dist:
            minion["x"], minion["y"] = target
            minion["segment"] += 1
            remaining -= dist
        else:
            minion["x"] += dx/dist*remaining
            minion["y"] += dy/dist*remaining
            remaining = 0
    # Minions disappear after reaching the end of the track.
    return minion["segment"] < len(PATH)-1


def update_game(dt):
    if game["paused"] or game["won"] or game["lost"]:
        return

    # During preparation, count down to the next wave.
    if game["prep"] > 0:
        game["prep"] -= dt

        if game["prep"] <= 0:
            # IMPORTANT: advance to the next wave.
            next_wave = game["wave"]+1

            if next_wave <= game["map"]["waves"]:
                start_wave(next_wave)

        return

    # Spawn remaining enemies in the current wave.
    if game["spawn_left"] > 0:
        game["spawn_timer"] -= dt

        if game["spawn_timer"] <= 0:
            spawn_enemy()
            game["spawn_left"] -= 1
            game["spawn_timer"] = max(.18, .66-game["wave"]*.025)

    # Move enemies smoothly.
    survivors = []

    for enemy in game["enemies"]:
        if move_enemy(enemy, dt):
            survivors.append(enemy)

    game["enemies"] = survivors

    # Move allied minions along the track.
    active_minions = []
    for minion in game["minions"]:
        if move_minion(minion, dt):
            active_minions.append(minion)
    game["minions"] = active_minions

    # Magic Frog periodically summons a small ally onto the track.
    # Higher tower levels increase minion HP and damage, not the summon rate.
    for tower in game["towers"]:
        if tower["name"] != "Magic Frog":
            continue
        tower["summon_cooldown"] = tower.get("summon_cooldown", 2.0) - dt
        owned_minions = sum(m["owner"] == id(tower) for m in game["minions"])
        if tower["summon_cooldown"] <= 0 and owned_minions < 3:
            level = tower["level"]
            minion_hp = 25 + (level-1)*15
            game["minions"].append({
                "x": PATH[0][0], "y": PATH[0][1], "segment": 0,
                "hp": minion_hp, "maxhp": minion_hp,
                "speed": 42, "damage": 5 + (level-1)*2,
                "attack_cooldown": 0.0, "owner": id(tower)
            })
            tower["summon_cooldown"] = 8.0
            game["notice"] = f'Magic Frog summoned a minion! Lv.{level} minion HP: {minion_hp}'
            game["notice_until"] = time.monotonic()+2.0

    # Tower attacks.
    for tower in game["towers"]:
        info = FROGS[tower["name"]]
        tower["cooldown"] -= dt

        if tower["cooldown"] > 0:
            continue

        level = tower["level"]
        radius = info["range"]+(level-1)*8
        damage = info["damage"]*(1+(level-1)*.65)

        targets = [
            enemy for enemy in game["enemies"]
            if distance((tower["x"], tower["y"]),
                        (enemy["x"], enemy["y"])) <= radius
        ]

        if not targets:
            continue

        target = max(targets, key=lambda enemy: enemy["segment"])
        target["hp"] -= damage
        tower["cooldown"] = info["rate"]/(1+(level-1)*.1)

        if target["hp"] <= 0:
            game["coins"] += target["reward"]
            game["coins_gained"] += target["reward"]
            game["kills"] += 1
            tower["kills"] += 1
            record_enemy_kill(target["kind"])

            game["notice"] = (
                f'{target["kind"]} defeated! '
                f'+{target["reward"]} match coins'
            )
            game["notice_until"] = time.monotonic()+1.5

            if target in game["enemies"]:
                game["enemies"].remove(target)

    # Defeat check.
    if game["lives"] <= 0:
        game["lost"] = True
        game["notice"] = "The swamp has been overrun!"
        return

    # WAVE PROGRESSION FIX:
    # Advance only after all enemies have spawned AND the field is empty.
    wave_finished = (
        game["spawn_left"] == 0 and
        len(game["enemies"]) == 0
    )

    if wave_finished and not game["wave_complete"]:
        game["wave_complete"] = True

        # Every cleared wave awards match coins. Retired event currencies are
        # no longer earned; previously collected event frogs remain usable.
        game["coins"] += 50
        game["coins_gained"] += 50

        if game["wave"] >= game["map"]["waves"]:
            game["won"] = True
            save["coins"] += game["map"]["reward"]
            # The two formerly-Catastrophic maps are now ordinary Medium/Hard
            # maps, but each still grants its own Legendary frog on first victory.
            map_name = game["map"]["name"]
            if map_name == "Lumpy Space Road" and not save.get("lumpy_space_reward_claimed", False):
                reward_frog = "LumpSomr'rog"
                save["inventory"][reward_frog] = owned(reward_frog) + 1
                save["lumpy_space_reward_claimed"] = True
                game["cat_reward_message"] = "LUMPSOMR'ROG UNLOCKED!"
            elif map_name == "Wizard City" and not save.get("wizard_city_reward_claimed", False):
                reward_frog = "Wiz ARts Master"
                save["inventory"][reward_frog] = owned(reward_frog) + 1
                save["wizard_city_reward_claimed"] = True
                game["cat_reward_message"] = "WIZ ARTS MASTER UNLOCKED!"
            if save.get("lumpy_space_reward_claimed") and save.get("wizard_city_reward_claimed"):
                save["catastrophic_unlocked"] = True
            game["notice"] = f'VICTORY! +{game["map"]["reward"]} saved coins!'
            save_game()
        else:
            game["notice"] = f'Wave {game["wave"]} cleared! +50 match coins!'
            game["notice_until"] = time.monotonic()+2.5
            game["prep"] = 2.0


