def place_tower(x, y):
    if not game or game["won"] or game["lost"]:
        return

    name = game["placing"]
    if not name:
        return

    info = FROGS[name]
    count = sum(t["name"] == name for t in game["towers"])

    if count >= info["limit"]:
        game["notice"] = f'{name} limit: {info["limit"]}.'
        game["notice_until"] = time.monotonic()+2.5
        game["placing"] = None
        return

    # Each frog uses its own listed placement cost.
    place_cost = info["cost"]
    if game["coins"] < place_cost:
        game["notice"] = f'Need {place_cost} match coins to place a frog.'
        game["notice_until"] = time.monotonic()+2.5
        game["placing"] = None
        return

    if point_on_path(x, y):
        game["notice"] = "You cannot place a frog on the path."
        game["notice_until"] = time.monotonic()+2
        return

    if x < -535 or x > 535 or y < -320 or y > 300:
        return

    if any(distance((x, y), (t["x"], t["y"])) < 43
           for t in game["towers"]):
        game["notice"] = "Too close to another frog."
        game["notice_until"] = time.monotonic()+2
        return

    game["coins"] -= place_cost

    game["towers"].append({
        "name": name,
        "x": x,
        "y": y,
        "level": 1,
        "cooldown": .1,
        "summon_cooldown": 2.0,
        "kills": 0,
    })

    game["selected_tower"] = len(game["towers"])-1
    game["placing"] = None
    game["notice"] = f'Placed {name} for {place_cost} match coins.'
    game["notice_until"] = time.monotonic()+2.5


def select_placing(name):
    if not game or game["won"] or game["lost"]:
        return

    game["placing"] = name
    game["selected_tower"] = None
    game["notice"] = f"Click an open area to place {name}."
    game["notice_until"] = time.monotonic()+3


def sell_selected():
    """Sell the selected frog for 75% of its listed frog cost."""
    if not game or game["won"] or game["lost"]:
        return

    index = game["selected_tower"]
    if index is None or index < 0 or index >= len(game["towers"]):
        game["notice"] = "Click a frog first to sell it."
        game["notice_until"] = time.monotonic()+2.5
        return

    tower = game["towers"].pop(index)
    frog_cost = FROGS[tower["name"]]["cost"]
    refund = int(frog_cost * 0.75)
    game["coins"] += refund
    game["coins_gained"] += refund
    game["selected_tower"] = None
    game["placing"] = None
    game["notice"] = f'Sold {tower["name"]} for {refund} match coins (75%).'
    game["notice_until"] = time.monotonic()+3


def upgrade_selected():
    if not game:
        return

    index = game["selected_tower"]

    if index is None or index >= len(game["towers"]):
        return

    tower = game["towers"][index]
    cost = 60*tower["level"]

    if tower["level"] >= 5:
        game["notice"] = "This frog is already max level."
    elif game["coins"] < cost:
        game["notice"] = f"Upgrade costs {cost} coins."
    else:
        game["coins"] -= cost
        tower["level"] += 1
        game["notice"] = f'{tower["name"]} upgraded to Lv.{tower["level"]}!'

    game["notice_until"] = time.monotonic()+2.5


def award_match_end_bonus():
    """Award the 50 match-coin completion bonus exactly once per match."""
    if game and not game.get("end_bonus_awarded", False):
        game["coins"] += 50
        game["coins_gained"] += 50
