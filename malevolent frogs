def load_save():
    default = {
        "coins": 0,
        "inventory": {"Frog": 1},
        "equipped": ["Frog"],
        "enemy_kills": {},
        "catastrophic_unlocked": False,
        "lumpy_space_reward_claimed": False,
        "wizard_city_reward_claimed": False
    }

    if not os.path.exists(SAVE_FILE):
        return default

    try:
        with open(SAVE_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)

        for key, value in default.items():
            data.setdefault(key, value)

        if not isinstance(data["inventory"], dict):
            data["inventory"] = {"Frog": 1}

        if not isinstance(data["equipped"], list):
            data["equipped"] = ["Frog"]
        if not isinstance(data.get("enemy_kills"), dict):
            data["enemy_kills"] = {}
        data.setdefault("catastrophic_unlocked", False)
        # Older saves awarded both map frogs together after a Catastrophic clear.
        # Preserve that progress when loading those saves.
        data.setdefault("lumpy_space_reward_claimed", bool(data.get("catastrophic_unlocked", False)))
        data.setdefault("wizard_city_reward_claimed", bool(data.get("catastrophic_unlocked", False)))

        data["equipped"] = [
            name for name in data["equipped"] if name in FROGS
        ][:8]

        if data["inventory"].get("Frog", 0) < 1:
            data["inventory"]["Frog"] = 1

        if not data["equipped"]:
            data["equipped"] = ["Frog"]

        return data

    except (OSError, ValueError, TypeError):
        return default


save = load_save()


def save_game():
    try:
        with open(SAVE_FILE, "w", encoding="utf-8") as f:
            json.dump(save, f, indent=2)
    except OSError:
        pass


def owned(name):
    return int(save["inventory"].get(name, 0))


