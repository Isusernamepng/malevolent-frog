def rect(t, x, y, w, h, color, outline=None):
    t.penup()
    t.goto(x, y)
    t.setheading(0)
    t.color(outline or color, color)
    t.pendown()
    t.begin_fill()

    for _ in range(2):
        t.forward(w)
        t.left(90)
        t.forward(h)
        t.left(90)

    t.end_fill()
    t.penup()


def text(t, x, y, value, size=12, color="#ffffff",
         align="left"):
    t.penup()
    t.goto(x, y)
    t.color(color)
    t.write(str(value), align=align,
            font=("Arial", size, "normal"))


def circle(t, x, y, radius, color, outline=None):
    t.penup()
    t.goto(x, y-radius)
    t.setheading(0)
    t.color(outline or color, color)
    t.pendown()
    t.begin_fill()
    t.circle(radius)
    t.end_fill()
    t.penup()


def line(t, points, color, width=3):
    t.penup()
    t.goto(points[0])
    t.pencolor(color)
    t.pensize(width)
    t.pendown()

    for point in points[1:]:
        t.goto(point)

    t.penup()
    t.pensize(1)


